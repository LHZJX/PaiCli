# GLM API Key
# 请将此文件复制为 .env 并填入你的 API Key
# 或者设置环境变量 GLM_API_KEY

GLM_API_KEY=your_api_key_here

# --- 沙箱保护(可选配置) ---
# 沙箱根目录: 目录内文件操作自动放行; 越界操作/白名单外命令需用户确认
# 不设置则默认使用 CLI 启动目录
# PAI_SANDBOX_DIR=
# execute_command 超时(秒), 默认 600, 超时强制终止
# PAI_CMD_TIMEOUT_SEC=600
# execute_command 输出上限(字节), 默认 524288(512KB), 超出截断
# PAI_CMD_OUTPUT_LIMIT=524288
